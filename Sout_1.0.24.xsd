										<xs:element name="Tools" type="xs:string" minOccurs="0" maxOccurs="1"/>
										<!--Перечень используемых инструментов-->
										<!--Добавлен в соответствии с N 136-ФЗ от 01.05.2016.-->
										<xs:element name="JobDescription" type="xs:string" minOccurs="0" maxOccurs="1"/>
