										<!--Дополнительный аттестат аккредитации-->
										<xs:element name="Address" type="PostAddress_" minOccurs="0" maxOccurs="1"/>
										<!--Почтовый адрес (для импорта)-->
										<xs:element name="Phone" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
										<!--Номер телефона (для импорта)-->
										<xs:element name="Fax" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
										<!--Номер факса (для импорта)-->
										<xs:element name="E-mail" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
										<!--Адрес электронной почты (для импорта)-->
