							<xs:element name="Accident" type="Accident_" minOccurs="0" maxOccurs="unbounded"/>
							<!--Статистические данные по несчастным случаям на предприятии за последние пять лет -->

							<xs:element name="WorkPlaceDeclared" minOccurs="0" maxOccurs="unbounded">
								<!--Рабочее место вошедшее в декларацию соответствия условий труда государственным нормативным требованиям охраны труда, -->
