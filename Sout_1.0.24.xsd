										<xs:element name="CertificateNumber" type="CertificateNumber_" minOccurs="1" maxOccurs="1"/>
										<!--Регистрационный номер аттестата аккредитации-->
										<xs:element name="CertificateIssueDate" type="xs:date" minOccurs="1" maxOccurs="1"/>
										<!--Дата выдачи аттестата аккредитации-->
										<xs:element name="CertificateExpiryDate" type="xs:date" minOccurs="0" maxOccurs="1"/>
										<!--Дата истечения срока действия аттестата аккредитации-->
										<xs:element name="AgencyName" type="xs:string" minOccurs="0" maxOccurs="1"/>
										<!--Наименование организации, выдавшей сертификат (для импорта)-->
										<xs:element name="AccreditationScope"  minOccurs="0" maxOccurs="1">
											<!--Область деятельности по аккредитации (для импорта)-->
											<xs:complexType>
												<xs:sequence>
													<xs:element name="Description" type="xs:string" minOccurs="0" maxOccurs="1"/>
													<!--Текстовое описание области деятельности-->
													<xs:element name="Scope" type="AccreditationScope_" minOccurs="1" maxOccurs="19"/>
