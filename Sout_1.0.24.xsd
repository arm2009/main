												</xs:sequence>
												<xs:attribute name="Name" type="xs:string" use="optional"/>
											</xs:complexType>
										</xs:element>

									</xs:sequence>
								</xs:complexType>
							</xs:element>

							<xs:element name="WorkPlaceImpossibleMeasurements" minOccurs="0" maxOccurs="unbounded">
								<!--Рабочее место на котором невозможно проведение исследований (испытаний) и измерений вредных и (или) опасных факторов-->
