									<xs:sequence>
										<xs:element name="Id" type="xs:string" minOccurs="1" maxOccurs="1"/>
										<!--Номер рабочего места-->
										<xs:element name="WorkPlaceDeclared" type="bit" minOccurs="0" maxOccurs="1"/>
