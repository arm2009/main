										<!--К-во женщин, занятых на рабочем месте-->
										<xs:element name="TeenagersQuantity" type="xs:integer" minOccurs="0" maxOccurs="1"/>
										<!--К-во лиц в возрвсте до 18 лет, занятых на рабочем месте-->
										<xs:element name="InvalidsQuantity" type="xs:integer" minOccurs="0" maxOccurs="1"/>
										<!--К-во инвалидов, занятых на рабочем месте-->
										<xs:element name="CommitteeProtocol" type="xs:string" minOccurs="1" maxOccurs="1"/>
