							<!--Дата окончания аттестата аккредитации-->
							<xs:element name="AdditionalCertificate" type="LaboratoryAccreditationCertificate_" minOccurs="0" maxOccurs="unbounded"/>
							<!--Дополнительный аттестат аккредитации-->
							<xs:element name="MeasuringTool" minOccurs="1" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="SerialNumber" type="xs:string" minOccurs="1" maxOccurs="1"/>
										<!--Заводской номер-->
										<xs:element name="CalibrationExpiryDate" type="xs:date" minOccurs="1" maxOccurs="1"/>
										<!--Дата окончания срока действия поверки средства измерения-->
										<xs:element name="Name" type="xs:string" minOccurs="1" maxOccurs="1"/>
