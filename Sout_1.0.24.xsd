								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<xs:element name="Enterprise" minOccurs="1" maxOccurs="1">
					<!--Предприятие, где проводилась СОУТ-->
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Name" type="OrganizationName" minOccurs="1" maxOccurs="1"/>
