										<!--Статистические данные по профессиональным заболеваниям на рабочем месте за последние пять лет-->

										<xs:element name="Compensations" minOccurs="0" maxOccurs="1">
											<!--Гарантии и компенсации, предоставляемые работнику (работникам)-->
											<xs:complexType>
												<xs:sequence>
													<xs:element name="PayIncrease" type="CompensationAttributes" minOccurs="1" maxOccurs="1"/>
													<!--Повышенная оплата труда-->
													<xs:element name="CompensatoryLeave" type="CompensationAttributes" minOccurs="1" maxOccurs="1"/>
													<!--Ежегодный дополнительный оплачиваемый отпуск-->
													<xs:element name="HalfDay" type="CompensationAttributes" minOccurs="1" maxOccurs="1"/>
													<!--Сокращенная продолжительность рабочего времени-->
													<xs:element name="Milk" type="CompensationAttributes" minOccurs="1" maxOccurs="1"/>
