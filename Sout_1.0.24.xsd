										<xs:element name="SubUnit" type="SubUnit_" minOccurs="0" maxOccurs="1"/>
										<!--Наименование структурного подразделения -->
										<xs:element name="Profession" type="ProfessionKod" minOccurs="1" maxOccurs="1"/>
										<!--Код профессии (должности) работников, занятых на рабочем месте, по ОКПДТР (ОК 016-94)-->
										<xs:element name="WorkersQuantity" type="xs:integer" minOccurs="1" maxOccurs="1"/>
										<!--Общее число работников, занятых на рабочем месте-->
